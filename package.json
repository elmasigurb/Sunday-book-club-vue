{
  "name": "sunday-book-club",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vue-tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "security:rls": "tsx server/scripts/audit-rls.ts",
    "security:client": "tsx server/scripts/audit-supabase-client.ts",
    "start:server": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.15.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
